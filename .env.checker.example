# Copy this file to .env on the server that will run discord_bot_checker.py.
# Never commit a real .env file or paste your real Discord token into chat.

# Required: Discord bot token from the Discord Developer Portal > Bot page.
DISCORD_TOKEN=replace_with_your_discord_bot_token

# Optional but recommended for one-server installs: sync slash commands instantly to this server.
# Use the Discord server/guild ID, not the channel ID.
GUILD_ID=replace_with_your_discord_server_id

# Required for /approve-checker-user: comma-separated Discord user IDs that can approve users.
OWNER_IDS=replace_with_your_discord_user_id

# Optional: JSON file path for approved Discord users. Keep this file persistent on your server.
KEY_STORE_PATH=data/lifetime_keys.json
