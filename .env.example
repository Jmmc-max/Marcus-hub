# Required: Discord bot token from the Discord Developer Portal.
DISCORD_TOKEN=your_real_bot_token_here

# Optional but recommended while testing: your Discord server/guild ID for fast command sync.
GUILD_ID=your_discord_server_id_here

# Required for /create-lifetime-key: comma-separated Discord user IDs allowed to create keys.
OWNER_IDS=your_discord_user_id_here

# Optional: where lifetime keys are stored locally.
KEY_STORE_PATH=data/lifetime_keys.json

# Optional: HTTP port for the Discord Interactions server. Include this port in the endpoint URL if your public host requires it.
PORT=3000
